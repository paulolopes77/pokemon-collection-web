# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Vercel). NUNCA com prefixo NEXT_PUBLIC_ e nunca no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: chave gratuita da Pokémon TCG API (https://dev.pokemontcg.io) para limites mais altos
POKEMONTCG_API_KEY=

# Segredo para o cron diário de preços (o Vercel envia-o automaticamente em Authorization: Bearer ...)
CRON_SECRET=

# Emails dos administradores (separados por vírgula): vêem a página «Utilizadores» e podem criar/apagar contas
ADMIN_EMAILS=
